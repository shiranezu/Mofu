# Django Settings
SECRET_KEY='django-insecure-70+6!%%5h2z2dh6z$+!jj*7)ic8ezxe*k%_*1@45_qe4%umcp#'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF trusted origins — leave blank locally. On your hosting platform,
# set this to your live domain(s), e.g.
# CSRF_TRUSTED_ORIGINS=https://mofu.up.railway.app
CSRF_TRUSTED_ORIGINS=

# Database — leave blank locally to use SQLite. On your hosting platform's
# dashboard, set this to the PostgreSQL connection string it gives you.
DATABASE_URL=

# Email — console backend prints emails to the terminal instead of sending
# them. Swap to a real SMTP backend when ready to go live.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Mofu <noreply@mofu.app>
CONTACT_EMAIL=your-email@example.com
